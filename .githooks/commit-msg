#!/bin/sh
# Validates a commit message. Used locally (git config core.hooksPath .githooks) and by CI.
# Usage: commit-msg <file containing the message>
msg_file="$1"
subject=$(sed -n '1p' "$msg_file")

# Merge and revert commits generated by git are exempt.
case "$subject" in
  "Merge "*|"Revert "*) exit 0 ;;
esac

if ! printf '%s' "$subject" | grep -Eq '^(feat|fix|refactor|test|docs|chore|security)(\([a-z0-9._/-]+\))?!?: .+'; then
  echo "Commit subject must follow Conventional Commits, for example:" >&2
  echo "  feat(incidents): add severity filter" >&2
  echo "Allowed types: feat, fix, refactor, test, docs, chore, security" >&2
  echo "Got: $subject" >&2
  exit 1
fi

if [ "${#subject}" -gt 100 ]; then
  echo "Commit subject is ${#subject} characters; keep it to 100 or fewer." >&2
  exit 1
fi

# Project rule: commits carry no AI or tool attribution.
if grep -Eiq '^(co-authored-by|generated[ -](with|by)):?.*(claude|anthropic|copilot|chatgpt|openai|gemini|cursor)|🤖' "$msg_file"; then
  echo "Commit messages must not contain AI or tool attribution lines." >&2
  exit 1
fi
