{
  "$comment": "GENERATED by `uv run python -m app.contracts` in services/ai. Do not edit.",
  "$defs": {
    "Assessment": {
      "description": "Whether the evidence shows a fault at all. Computed from the evidence by app/assessment.py,\nfor every engine, so that a report cannot talk a healthy service into an incident.",
      "properties": {
        "outcome": {
          "enum": [
            "HEALTHY",
            "DEGRADED",
            "INCIDENT",
            "UNDETERMINED"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "supportingRefs": {
          "items": {
            "type": "string"
          },
          "title": "Supportingrefs",
          "type": "array"
        },
        "signals": {
          "items": {
            "$ref": "#/$defs/Signal"
          },
          "title": "Signals",
          "type": "array"
        },
        "missingTelemetry": {
          "items": {
            "type": "string"
          },
          "title": "Missingtelemetry",
          "type": "array"
        }
      },
      "required": [
        "outcome",
        "confidence",
        "rationale"
      ],
      "title": "Assessment",
      "type": "object"
    },
    "ClaimCheck": {
      "description": "One figure or identifier found in a statement, and whether the evidence bears it out.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "kind": {
          "enum": [
            "number",
            "timestamp",
            "version",
            "commit",
            "pull_request",
            "incident"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "exact",
            "rounded",
            "calculated",
            "estimate",
            "uncited",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "evidenceRef": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidenceref"
        }
      },
      "required": [
        "text",
        "kind",
        "status",
        "detail"
      ],
      "title": "ClaimCheck",
      "type": "object"
    },
    "Fact": {
      "properties": {
        "statement": {
          "description": "Something directly observed in the evidence, not an inference",
          "title": "Statement",
          "type": "string"
        },
        "evidenceRefs": {
          "description": "Evidence references (e.g. E3) that show this",
          "items": {
            "type": "string"
          },
          "title": "Evidencerefs",
          "type": "array"
        },
        "verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/Verification"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "statement",
        "evidenceRefs"
      ],
      "title": "Fact",
      "type": "object"
    },
    "FlaggedClaim": {
      "properties": {
        "where": {
          "title": "Where",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "status": {
          "enum": [
            "exact",
            "rounded",
            "calculated",
            "estimate",
            "uncited",
            "unsupported"
          ],
          "title": "Status",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "where",
        "text",
        "status",
        "detail"
      ],
      "title": "FlaggedClaim",
      "type": "object"
    },
    "HypothesisOut": {
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "description": "The causal mechanism proposed and how the evidence supports it",
          "title": "Description",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "status": {
          "enum": [
            "likely",
            "possible",
            "unlikely"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidenceRefs": {
          "description": "Evidence that supports this hypothesis",
          "items": {
            "type": "string"
          },
          "title": "Evidencerefs",
          "type": "array"
        },
        "contradictingEvidenceRefs": {
          "description": "Evidence that argues against this hypothesis",
          "items": {
            "type": "string"
          },
          "title": "Contradictingevidencerefs",
          "type": "array"
        },
        "contradictions": {
          "description": "What in the evidence does not fit this hypothesis",
          "items": {
            "type": "string"
          },
          "title": "Contradictions",
          "type": "array"
        },
        "facts": {
          "description": "Observed facts supporting this hypothesis",
          "items": {
            "type": "string"
          },
          "title": "Facts",
          "type": "array"
        },
        "assumptions": {
          "description": "What is assumed but not verified",
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "gaps": {
          "description": "Evidence that would confirm or refute it",
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "required": [
        "title",
        "description",
        "confidence",
        "status"
      ],
      "title": "HypothesisOut",
      "type": "object"
    },
    "Integrity": {
      "description": "Result of checking every figure and identifier in the report against the evidence.",
      "properties": {
        "checked": {
          "default": 0,
          "title": "Checked",
          "type": "integer"
        },
        "supported": {
          "default": 0,
          "title": "Supported",
          "type": "integer"
        },
        "flagged": {
          "items": {
            "$ref": "#/$defs/FlaggedClaim"
          },
          "title": "Flagged",
          "type": "array"
        }
      },
      "title": "Integrity",
      "type": "object"
    },
    "RecommendedAction": {
      "properties": {
        "type": {
          "enum": [
            "rollback_deployment",
            "restart_service",
            "scale_service",
            "toggle_feature_flag",
            "config_change",
            "run_runbook",
            "manual"
          ],
          "title": "Type",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "risk": {
          "default": "MEDIUM",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ],
          "title": "Risk",
          "type": "string"
        },
        "effect": {
          "default": "state_changing",
          "enum": [
            "read_only",
            "state_changing"
          ],
          "title": "Effect",
          "type": "string"
        },
        "effectReasons": {
          "items": {
            "type": "string"
          },
          "title": "Effectreasons",
          "type": "array"
        },
        "serviceSlug": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Serviceslug"
        },
        "parameters": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemediationParameters"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "evidenceRefs": {
          "items": {
            "type": "string"
          },
          "title": "Evidencerefs",
          "type": "array"
        }
      },
      "required": [
        "type",
        "title",
        "description"
      ],
      "title": "RecommendedAction",
      "type": "object"
    },
    "RemediationParameters": {
      "description": "Typed on purpose. A free-form object cannot be expressed in a strict output schema: the\nprovider receives it as an empty object and the model can then supply no parameters at all.",
      "properties": {
        "deploymentId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For rollback_deployment: sourceId of the deployment evidence being rolled back",
          "title": "Deploymentid"
        },
        "fromVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version currently running",
          "title": "Fromversion"
        },
        "toVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Version to return to",
          "title": "Toversion"
        },
        "featureFlag": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For toggle_feature_flag: the flag name",
          "title": "Featureflag"
        },
        "enabled": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For toggle_feature_flag: desired state",
          "title": "Enabled"
        },
        "replicas": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For scale_service: desired replica count",
          "title": "Replicas"
        },
        "configKey": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For config_change: the setting to change",
          "title": "Configkey"
        },
        "configValue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For config_change: the new value",
          "title": "Configvalue"
        },
        "runbook": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For run_runbook: title of the runbook to follow",
          "title": "Runbook"
        }
      },
      "title": "RemediationParameters",
      "type": "object"
    },
    "Signal": {
      "properties": {
        "level": {
          "enum": [
            "strong",
            "moderate",
            "weak"
          ],
          "title": "Level",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "evidenceRefs": {
          "items": {
            "type": "string"
          },
          "title": "Evidencerefs",
          "type": "array"
        }
      },
      "required": [
        "level",
        "kind",
        "text"
      ],
      "title": "Signal",
      "type": "object"
    },
    "TimelineEntry": {
      "properties": {
        "timestamp": {
          "description": "ISO-8601 time of the event",
          "title": "Timestamp",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidenceRefs": {
          "items": {
            "type": "string"
          },
          "title": "Evidencerefs",
          "type": "array"
        }
      },
      "required": [
        "timestamp",
        "description"
      ],
      "title": "TimelineEntry",
      "type": "object"
    },
    "Verification": {
      "description": "Set by the service after the report is written; never by the model.",
      "properties": {
        "status": {
          "enum": [
            "verified",
            "partly",
            "unsupported",
            "no_claims"
          ],
          "title": "Status",
          "type": "string"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/ClaimCheck"
          },
          "title": "Checks",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "Verification",
      "type": "object"
    }
  },
  "properties": {
    "summary": {
      "description": "3-6 sentences: what happened, the leading explanation, and how sure we are",
      "title": "Summary",
      "type": "string"
    },
    "confidence": {
      "description": "Overall confidence in the leading hypothesis",
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "analysisMode": {
      "default": "llm",
      "enum": [
        "llm",
        "heuristic",
        "mock"
      ],
      "title": "Analysismode",
      "type": "string"
    },
    "rootCauseConfirmed": {
      "const": false,
      "default": false,
      "title": "Rootcauseconfirmed",
      "type": "boolean"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "HEALTHY",
            "DEGRADED",
            "INCIDENT",
            "UNDETERMINED"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "assessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/Assessment"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Observations",
      "type": "array"
    },
    "integrity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Integrity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/TimelineEntry"
      },
      "title": "Timeline",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    },
    "assumptions": {
      "items": {
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "uncertainties": {
      "description": "What is unknown or could not be checked",
      "items": {
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/HypothesisOut"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "nextSteps": {
      "description": "Concrete checks a human should do next",
      "items": {
        "type": "string"
      },
      "title": "Nextsteps",
      "type": "array"
    },
    "recommendedActions": {
      "items": {
        "$ref": "#/$defs/RecommendedAction"
      },
      "title": "Recommendedactions",
      "type": "array"
    }
  },
  "required": [
    "summary",
    "confidence"
  ],
  "title": "InvestigationReport",
  "type": "object"
}
