{
  "$comment": "What may leave a process inside a span. Both services scrub span attributes before export (apps/api/src/lib/tracing.ts, services/ai/app/tracing.py) and both test suites run these cases. `expected` omits a key that must be dropped.",
  "cases": [
    { "name": "credentials in headers are dropped", "attributes": { "http.request.header.authorization": "Bearer abc.def.ghi", "http.request.header.cookie": "opspilot_session=xyz", "http.request.header.x-api-key": "opk_live_123", "http.request.header.x-internal-token": "s3cret" }, "expected": {} },
    { "name": "identifiers of people are dropped", "attributes": { "enduser.id": "user_1", "user.email": "ada@example.com", "user.id": "u1", "client.address": "203.0.113.9", "http.client_ip": "203.0.113.9", "net.peer.ip": "203.0.113.9" }, "expected": {} },
    { "name": "the user agent is not a person", "attributes": { "user_agent.original": "node" }, "expected": { "user_agent.original": "node" } },
    { "name": "query strings are removed from URLs", "attributes": { "url.full": "http://api:4000/api/v1/tools/logs/search?q=card+declined&service=payments", "http.target": "/api/v1/logs?q=timeout", "url.query": "q=timeout" }, "expected": { "url.full": "http://api:4000/api/v1/tools/logs/search", "http.target": "/api/v1/logs" } },
    { "name": "a token in a path is removed", "attributes": { "url.path": "/api/v1/auth/invitations/9f8a7b6c5d4e3f2a1b0c", "http.url": "http://localhost:4000/api/v1/auth/invitations/9f8a7b6c5d4e3f2a1b0c?x=1" }, "expected": { "url.path": "/api/v1/auth/invitations/[redacted]", "http.url": "http://localhost:4000/api/v1/auth/invitations/[redacted]" } },
    { "name": "database and Redis statements keep only the operation", "attributes": { "db.statement": "hset bull:investigation:12 data {\"investigationId\":\"inv_1\"}", "db.query.text": "SELECT * FROM \"User\" WHERE email = 'ada@example.com'", "db.system": "redis" }, "expected": { "db.statement": "hset", "db.query.text": "SELECT", "db.system": "redis" } },
    { "name": "secrets inside other values are masked", "attributes": { "exception.message": "401 from upstream with Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiIxIn0.c2ln and key sk-ant-api03-abcDEF123", "error.detail": "invite sent to ada@example.com" }, "expected": { "exception.message": "401 from upstream with [redacted] and key [redacted]", "error.detail": "invite sent to [redacted]" } },
    { "name": "what describes the work is kept", "attributes": { "opspilot.investigation.id": "cmabc123", "opspilot.tool.name": "search_logs", "messaging.destination.name": "investigation", "http.response.status_code": 200, "http.route": "/api/v1/tools/logs/search", "opspilot.engine.mode": "heuristic", "opspilot.llm.input_tokens": 0 }, "expected": { "opspilot.investigation.id": "cmabc123", "opspilot.tool.name": "search_logs", "messaging.destination.name": "investigation", "http.response.status_code": 200, "http.route": "/api/v1/tools/logs/search", "opspilot.engine.mode": "heuristic", "opspilot.llm.input_tokens": 0 } }
  ]
}
